# Training/eval image for the laya Thai fine-tune experiment on laya 0.3.20: the run-time extras the upstream
# added since 0.3.5 (TileLang fast path, ONNX runtime) plus pytest for the upstream suite. The fork root is mounted at /work.
#   docker build -t laya-train-0320 -f thai/Dockerfile.0320 .
FROM openthai-systemone:0.1.0-batched
RUN pip install --no-cache-dir "datasets>=3.0" pytest "tilelang>=0.1.14" onnx onnxruntime-gpu && rm -rf /root/.cache/pip
WORKDIR /work
ENV HF_HOME=/hf PYTHONPATH=/work:/work/thai/ots PYTHONUNBUFFERED=1
ENTRYPOINT []
CMD ["bash"]
